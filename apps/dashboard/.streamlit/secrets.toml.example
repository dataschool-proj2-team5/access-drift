# Access Drift 대시보드 로컬 연결용 secrets 템플릿
#
# 사용법:
#   1) 이 파일을 같은 폴더에 secrets.toml 로 복사한다.
#        cp secrets.toml.example secrets.toml
#   2) 아래 값(특히 access_token)을 본인 것으로 채운다.
#   3) secrets.toml 은 .gitignore 에 걸려 있어 커밋되지 않는다. (토큰을 절대 커밋하지 말 것)
#
# access_token 발급: Databricks 워크스페이스 로그인
#   → 우측 상단 프로필 → Settings → Developer → Access tokens → Generate new token
#   (또는 로컬에 Databricks CLI 가 설정돼 있으면 ~/.databrickscfg 의 token 재사용 가능)

[databricks]
server_hostname = "adb-7405615323116390.10.azuredatabricks.net"
http_path       = "/sql/1.0/warehouses/8baac3b353ebbda4"   # SQL Warehouses > Starter Warehouse > Connection details 에서 확인
access_token    = "dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX"        # 본인 PAT 로 교체
catalog         = "access_drift_dev"
gold_schema     = "gold"
app_schema      = "app"

# AI Agent 챗봇이 사용하는 생성 LLM 엔드포인트.
# 생략하면 databricks-meta-llama-3-3-70b-instruct 를 사용한다 (워크스페이스 내장 FM API, 외부 key/개인 결제 불필요).
# Claude 등으로 바꾸려면 이 값만 교체: 예) databricks-claude-sonnet-5
llm_endpoint    = "databricks-meta-llama-3-3-70b-instruct"
